        "import gymnasium as gym\n",
        "\n",
        "\n",
        "def random_agent(env_name, episodes=10):\n",
        "\n",
        "    # Create environment\n",
        "    env = gym.make(env_name)\n",
        "\n",
        "    episode_rewards = []\n",
        "\n",
        "    print(\"\\n======================================\")\n",
        "    print(\"Environment:\", env_name)\n",
        "    print(\"======================================\")\n",
        "\n",
        "    # Repeat for multiple episodes\n",
        "    for episode in range(1, episodes + 1):\n",
        "\n",
        "        # S0 = Reset(E)\n",
        "        state, info = env.reset()\n",
        "\n",
        "        G = 0          # Total reward\n",
        "        T = 0          # Number of steps\n",
        "\n",
        "        terminated = False\n",
        "        truncated = False\n",
        "\n",
        "        # print(\"\\nEpisode:\", episode)\n",
        "        # print(\"Initial State:\", state)\n",
        "\n",
        "        # Continue until episode terminates\n",
        "        while not (terminated or truncated):\n",
        "\n",
        "            # At ~ Uniform(A)\n",
        "            action = env.action_space.sample()\n",
        "\n",
        "            # (S(t+1), R(t)) = Step(S(t), A(t))\n",
        "            next_state, reward, terminated, truncated, info = env.step(action)\n",
        "\n",
        "            # G = G + R(t)\n",
        "            G = G + reward\n",
        "\n",
        "            # T = T + 1\n",
        "            T = T + 1\n",
        "\n",
        "            # print(\n",
        "            #     \"State:\", state,\n",
        "            #     \"Action:\", action,\n",
        "            #     \"Reward:\", reward,\n",
        "            #     \"Next State:\", next_state\n",
        "            # )\n",
        "\n",
        "            # Move to next state\n",
        "            state = next_state\n",
        "\n",
        "        # Average reward = G / T\n",
        "        average_reward = G / T\n",
        "\n",
        "        episode_rewards.append(G)\n",
        "\n",
        "        print(\"\\nEpisode:\", episode)\n",
        "        print(\"Total Reward (G):\", G)\n",
        "        print(\"Number of Steps (T):\", T)\n",
        "        print(\"Average Reward (G/T):\", round(average_reward, 2))\n",
        "\n",
        "    # Average reward over multiple episodes\n",
        "    G_avg = sum(episode_rewards) / episodes\n",
        "\n",
        "    print(\"\\n======================================\")\n",
        "    print(\"FINAL RESULTS\")\n",
        "    print(\"======================================\")\n",
        "\n",
        "    for i in range(episodes):\n",
        "        print(\n",
        "            \"Episode\", i + 1,\n",
        "            \"-> Total Reward =\", episode_rewards[i]\n",
        "        )\n",
        "\n",
        "    print(\"\\nAverage Total Reward over all episodes:\\n\", round(G_avg, 2))\n",
        "\n",
        "    env.close()\n",
        "\n",
        "\n",
        "# -----------------------------------\n",
        "# 1. CliffWalking\n",
        "# -----------------------------------\n",
        "\n",
        "random_agent(\"CliffWalking-v1\", 10)\n",
        "\n",
        "\n",
